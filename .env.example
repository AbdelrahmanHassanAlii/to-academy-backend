NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/to_academy
# Required: generate with node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_COOKIE_NAME=toacademy.sid
PUBLIC_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Set only to the verified reverse proxy hop count; direct host development uses 0.
TRUST_PROXY_HOPS=0
# Required only by test:integration. Dedicated test DB, never production/application DB.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/to_academy_test
