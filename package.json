{
  "name": "to-academy-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1",
  "overrides": {
    "minimatch": "11.0.1"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/integration/**",
    "test:integration": "node --env-file-if-exists=.env --import tsx node_modules/vitest/vitest.mjs run tests/integration",
    "api:check": "tsx scripts/check-openapi.ts",
    "db:check": "node --env-file-if-exists=.env --import tsx scripts/check-database.ts"
  },
  "dependencies": {
    "connect-mongo": "6.0.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "mongoose": "9.12.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
